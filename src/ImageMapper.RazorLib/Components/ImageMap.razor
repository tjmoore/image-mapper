@rendermode InteractiveServer
@inject IImageService ImageService
@inject ICacheActivityStatus CacheStatus
@inject MapSectionJsInterop MapModule
@inject ProgressSectionJsInterop ProgressModule

@implements IAsyncDisposable

<div class="image-map-layout">
    <section class="image-map-panel">
        <MapSection />
    </section>
    <section class="image-map-info-panel">
        <StatusSection StatusText="@_cacheStatusText" />
        <ImageCountSection IsVisible="@_isImageCountVisible" ImageCount="@_imagesLoaded" SkippedCount="@_skippedImages" />
        <ProgressSection IsVisible="@_isProgressVisible" LoadedImages="@_imagesLoaded" TotalImages="@_totalImages" Percentage="@_progressPercentage" />
    </section>
</div>

<ImageModal />
