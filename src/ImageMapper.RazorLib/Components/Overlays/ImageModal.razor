@inject ImageModalJsInterop ImageModalModule
@inject ImageSourceJsInterop ImageSourceModule

@if (_isVisible)
{
    <div class="image-modal" @onclick="OnBackdropClick">
        <span class="close" @onclick="CloseModal" @onclick:stopPropagation="true">&times;</span>
        <div class="modal-inner" @onclick:stopPropagation="true">
            <div class="modal-image-area">
                <img id="@ImageElementId" class="modal-content" alt="Full-size image">
            </div>
            <div class="panel-divider">
                <button class="panel-toggle" @onclick="ToggleInfoPanel" title="@(_infoPanelOpen ? "Hide info" : "Show info")">
                    <span class="toggle-icon">@(_infoPanelOpen ? "›" : "‹")</span>
                </button>
            </div>
            <div class="info-panel @(_infoPanelOpen ? "open" : "")">
                <div class="info-panel-content">
                    <h3 class="info-panel-title">Image Info</h3>
                    @if (_currentImageInfo is not null)
                    {
                        <dl class="info-fields">
                            <dt>File Name</dt>
                            <dd>@_currentImageInfo.FileName</dd>
                            <dt>File Path</dt>
                            <dd class="file-path">@_currentImageInfo.FilePath</dd>
                            <dt>Width</dt>
                            <dd>@_currentImageInfo.Width px</dd>
                            <dt>Height</dt>
                            <dd>@_currentImageInfo.Height px</dd>
                            <dt>Latitude</dt>
                            <dd>@_currentImageInfo.Latitude.ToString("F6")</dd>
                            <dt>Longitude</dt>
                            <dd>@_currentImageInfo.Longitude.ToString("F6")</dd>
                            <dt>Time Taken</dt>
                            <dd>@_currentImageInfo.DateTimeOriginal.ToString("g")</dd>
                            @if (!string.IsNullOrEmpty(_currentImageInfo.TimeZoneOffset))
                            {
                                <dt>Time Zone Offset</dt>
                                <dd>@_currentImageInfo.TimeZoneOffset</dd>
                            }
                            @if (!string.IsNullOrEmpty(_currentImageInfo.CameraMaker))
                            {
                                <dt>Camera Maker</dt>
                                <dd>@_currentImageInfo.CameraMaker</dd>
                            }
                            @if (!string.IsNullOrEmpty(_currentImageInfo.CameraModel))
                            {
                                <dt>Camera Model</dt>
                                <dd>@_currentImageInfo.CameraModel</dd>
                            }
                            @if (!string.IsNullOrEmpty(_currentImageInfo.Aperture))
                            {
                                <dt>Aperture</dt>
                                <dd>@_currentImageInfo.Aperture</dd>
                            }
                            @if (!string.IsNullOrEmpty(_currentImageInfo.ShutterSpeed))
                            {
                                <dt>Shutter Speed</dt>
                                <dd>@_currentImageInfo.ShutterSpeed</dd>
                            }
                            @if (_currentImageInfo.Iso is not null)
                            {
                                <dt>ISO</dt>
                                <dd>@_currentImageInfo.Iso</dd>
                            }
                            @if (!string.IsNullOrEmpty(_currentImageInfo.FocalLength))
                            {
                                <dt>Focal Length</dt>
                                <dd>@_currentImageInfo.FocalLength</dd>
                            }
                            @if (_currentImageInfo.FlashFired is not null)
                            {
                                <dt>Flash Fired</dt>
                                <dd>@(_currentImageInfo.FlashFired.Value ? "Yes" : "No")</dd>
                            }
                        </dl>
                    }
                </div>
            </div>
        </div>
    </div>
}
