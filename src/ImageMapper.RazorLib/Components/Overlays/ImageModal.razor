@using Microsoft.JSInterop
@using ImageMapper.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_isVisible)
{
    <div class="image-modal" @onclick="OnBackdropClick">
        <span class="close" @onclick="CloseModal" @onclick:stopPropagation="true">&times;</span>
        <div class="modal-inner" @onclick:stopPropagation="true">
            <div class="modal-image-area">
                <img class="modal-content" src="@_imageSrc" alt="Full-size image">
            </div>
            <div class="panel-divider">
                <button class="panel-toggle" @onclick="ToggleInfoPanel" title="@(_infoPanelOpen ? "Hide info" : "Show info")">
                    <span class="toggle-icon">@(_infoPanelOpen ? "›" : "‹")</span>
                </button>
            </div>
            <div class="info-panel @(_infoPanelOpen ? "open" : "")">
                <div class="info-panel-content">
                    <h3 class="info-panel-title">Image Info</h3>
                    @if (_currentImageInfo is not null)
                    {
                        <dl class="info-fields">
                            <dt>File Name</dt>
                            <dd>@_currentImageInfo.FileName</dd>
                            <dt>File Path</dt>
                            <dd class="file-path">@_currentImageInfo.FilePath</dd>
                            <dt>Width</dt>
                            <dd>@_currentImageInfo.Width px</dd>
                            <dt>Height</dt>
                            <dd>@_currentImageInfo.Height px</dd>
                            <dt>Latitude</dt>
                            <dd>@_currentImageInfo.Latitude.ToString("F6")</dd>
                            <dt>Longitude</dt>
                            <dd>@_currentImageInfo.Longitude.ToString("F6")</dd>
                        </dl>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private bool _infoPanelOpen;
    private string _imageSrc = string.Empty;
    private ImageInfo? _currentImageInfo;
    private DotNetObjectReference<ImageModal>? _dotNetRef;
    private IJSObjectReference? _imageModalModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _imageModalModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/ImageMapper.RazorLib/Components/Overlays/ImageModal.razor.js");
            await _imageModalModule.InvokeVoidAsync("setImageModalDotNetRef", _dotNetRef);
            await _imageModalModule.InvokeVoidAsync("setupImageModalKeyHandler");
        }
    }

    [JSInvokable]
    public Task ShowImage(ImageInfo imageInfo)
    {
        _imageSrc = imageInfo.Url;
        _currentImageInfo = imageInfo;
        _isVisible = true;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task CloseModal()
    {
        _isVisible = false;
        return InvokeAsync(StateHasChanged);
    }

    private void OnBackdropClick()
    {
        _isVisible = false;
    }

    private void ToggleInfoPanel()
    {
        _infoPanelOpen = !_infoPanelOpen;
    }

    public async ValueTask DisposeAsync()
    {
        if (_imageModalModule is not null)
        {
            try { await _imageModalModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        _dotNetRef?.Dispose();
    }
}
